<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="#1E293B"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#334155"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- 1. Header: Nama Meja & Ustadz Pengajar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTableName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="MEJA 1 - SANTRI"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTeacherName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Pengajar: Ustadz"
                    android:textColor="#94A3B8"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Status Indicator Badge -->
            <TextView
                android:id="@+id/tvTableStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_badge_success"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2.5dp"
                android:text="AKTIF"
                android:textColor="#34D399"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="6dp"
            android:background="#334155" />

        <!-- 2. Current Serving Queue Box (Santri yang Sedang Mengaji / Dipanggil) -->
        <LinearLayout
            android:id="@+id/layoutCurrentServing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <!-- Jumbo Number Box -->
            <LinearLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="#0F172A"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOMOR"
                    android:textColor="#94A3B8"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCurrentNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01"
                    android:textColor="#38BDF8"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Student Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEDANG MENGAJI:"
                    android:textColor="#F59E0B"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCurrentStudentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Ahmad Dahlan"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCurrentNis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="NIS: 202401001"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Empty State (Saat Meja Siap Memanggil) -->
        <TextView
            android:id="@+id/tvEmptyCurrent"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#0F172A"
            android:gravity="center"
            android:padding="6dp"
            android:text="Meja siap memanggil santri"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- 3. Next Waiting Section (Rapi dengan Card Khusus & Sub-header) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#0F172A"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ANTRIAN BERIKUTNYA:"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWaitingCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Santri"
                    android:textColor="#FBBF24"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNextWaiting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="• #02 (Zaid)  • #03 (Fatimah)"
                android:textColor="#E2E8F0"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- 4. Footer Stats Grid (3 Kotak Berjejer Rapi: Menunggu | Mengaji | Selesai) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <!-- Kotak Menunggu -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2.5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_box"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:paddingHorizontal="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MENUNGGU"
                    android:textColor="#94A3B8"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatWaiting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="#FBBF24"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Kotak Selesai -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="2.5dp"
                android:layout_marginEnd="2.5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_box"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:paddingHorizontal="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELESAI"
                    android:textColor="#94A3B8"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12"
                    android:textColor="#34D399"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Kotak Total -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="2.5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_box"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:paddingHorizontal="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL"
                    android:textColor="#94A3B8"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15"
                    android:textColor="#E2E8F0"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
