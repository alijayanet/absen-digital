  </div>

  <!-- JavaScript Interaktif -->
  <script>
    // Inisialisasi dari LocalStorage jika ada
    document.addEventListener('DOMContentLoaded', () => {
      try {
        const savedConfig = localStorage.getItem('smartschool_card_preset');
        if (savedConfig) {
          const config = JSON.parse(savedConfig);
          if (config.orientation) document.getElementById('selectOrientation').value = config.orientation;
          if (config.model) document.getElementById('selectModel').value = config.model;
          if (config.theme) document.getElementById('selectTheme').value = config.theme;
          if (config.side) document.getElementById('selectSide').value = config.side;
          if (config.sigType && document.getElementById('selectSigType')) document.getElementById('selectSigType').value = config.sigType;
          if (typeof config.cutMarks === 'boolean') document.getElementById('checkCutMarks').checked = config.cutMarks;
          if (config.ribbonDir && document.getElementById('selectRibbonDir')) document.getElementById('selectRibbonDir').value = config.ribbonDir;
        }
      } catch (e) {
        console.warn('Gagal membaca cache preset kartu:', e);
      }
      applyPresetClasses();
    });

    function updateCardPreset() {
      applyPresetClasses();
      savePresetToStorage();
    }

    function applyPresetClasses() {
      const orientation = document.getElementById('selectOrientation').value;
      const model = document.getElementById('selectModel').value;
      const theme = document.getElementById('selectTheme').value;
      const side = document.getElementById('selectSide').value;
      const sigType = document.getElementById('selectSigType')?.value || 'digital';
      const cutMarks = document.getElementById('checkCutMarks').checked;
      const ribbonDir = document.getElementById('selectRibbonDir')?.value || 'bottom-up';

      // Bersihkan kelas lama di body
      const body = document.body;
      body.className = '';
      body.classList.add(
        'theme-' + theme,
        'layout-' + orientation,
        'model-' + model,
        'side-' + side,
        'sig-' + sigType
      );
      if (cutMarks) {
        body.classList.add('show-cutmarks');
      }
      if (ribbonDir === 'top-down') {
        body.classList.add('ribbon-dir-top-down');
      }

      // Tampilkan kontrol arah ribbon hanya jika model === 'sideribbon'
      const model4Controls = document.querySelectorAll('.model4-only');
      model4Controls.forEach(el => {
        el.style.display = (model === 'sideribbon') ? 'flex' : 'none';
      });

      // Update @page CSS dynamically for print dialog
      const printStyle = document.getElementById('printPageStyle');
      if (printStyle) {
        printStyle.innerHTML = `@page { size: ${orientation}; margin: 6mm; }`;
      }

      // Toggle display mode helper
      const landscapeBlocks = document.querySelectorAll('.layout-landscape-only');
      const portraitBlocks = document.querySelectorAll('.layout-portrait-only');

      if (orientation === 'portrait') {
        landscapeBlocks.forEach(el => el.style.display = 'none');
        portraitBlocks.forEach(el => el.style.display = 'flex');
      } else {
        landscapeBlocks.forEach(el => el.style.display = 'flex');
        portraitBlocks.forEach(el => el.style.display = 'none');
      }
    }

    function savePresetToStorage() {
      const config = {
        orientation: document.getElementById('selectOrientation').value,
        model: document.getElementById('selectModel').value,
        theme: document.getElementById('selectTheme').value,
        side: document.getElementById('selectSide').value,
        sigType: document.getElementById('selectSigType')?.value || 'digital',
        cutMarks: document.getElementById('checkCutMarks').checked,
        ribbonDir: document.getElementById('selectRibbonDir')?.value || 'top-down'
      };
      try {
        localStorage.setItem('smartschool_card_preset', JSON.stringify(config));
      } catch (e) {}
    }

    function setZoom(scale) {
      const wrapper = document.getElementById('sheetWrapper');
      if (wrapper) {
        wrapper.style.transform = `scale(${scale})`;
      }
      document.querySelectorAll('.btn-toggle').forEach(b => b.classList.remove('active'));
      event.target.classList.add('active');
    }

    // ====================================================
    // CEK STATUS WHATSAPP GATEWAY
    // ====================================================
    async function checkWaStatus() {
      const badge = document.getElementById('waStatusBadge');
      if (!badge) return;
      try {
        const res = await fetch('/dashboard/students/cards/wa-status');
        const data = await res.json();
        if (data.connected) {
          badge.innerHTML = '<span style="width:7px;height:7px;border-radius:50%;background:#10b981;"></span><span style="color:#047857;">WA Gateway Online</span>';
          badge.style.borderColor = '#a7f3d0';
          badge.style.background = '#ecfdf5';
        } else {
          badge.innerHTML = '<span style="width:7px;height:7px;border-radius:50%;background:#ef4444;"></span><span style="color:#b91c1c;">WA Gateway Offline</span>';
          badge.style.borderColor = '#fecaca';
          badge.style.background = '#fef2f2';
        }
      } catch (e) {
        badge.innerHTML = '<span style="width:7px;height:7px;border-radius:50%;background:#f59e0b;"></span><span style="color:#b45309;">WA Status Tidak Diketahui</span>';
      }
    }
    document.addEventListener('DOMContentLoaded', checkWaStatus);

    // ====================================================
    // RENDER CARD KE CANVAS MENGGUNAKAN HTML2CANVAS
    // ====================================================
    async function renderCardToCanvas(el) {
      if (!el) throw new Error('Elemen kartu tidak ditemukan');
      if (typeof html2canvas === 'undefined') {
        throw new Error('Pustaka html2canvas belum siap. Silakan muat ulang halaman.');
      }

      // Pastikan webfonts telah selesai di-load sebelum digambar ke canvas
      if (document.fonts && document.fonts.ready) {
        try { await document.fonts.ready; } catch (e) {}
      }

      // Pastikan transformasi zoom tidak mengganggu kalkulasi posisi canvas
      const wrapper = document.getElementById('sheetWrapper');
      const oldTransform = wrapper ? wrapper.style.transform : '';
      if (wrapper) wrapper.style.transform = 'none';

      // Sembunyikan garis potong sementara agar hasil gambar bersih
      const hadCutMarks = document.body.classList.contains('show-cutmarks');
      if (hadCutMarks) document.body.classList.remove('show-cutmarks');

      try {
        const canvas = await html2canvas(el, {
          scale: 3, // Skala 3x menghasilkan resolusi ~300 DPI, tajam untuk dicetak
          useCORS: true,
          allowTaint: true,
          backgroundColor: '#ffffff',
          logging: false,
          imageTimeout: 15000
        });
        return canvas;
      } finally {
        if (wrapper) wrapper.style.transform = oldTransform;
        if (hadCutMarks) document.body.classList.add('show-cutmarks');
      }
    }

    // Render gabungan Depan & Belakang dalam 1 Canvas Berdampingan
    async function renderCombinedCardsToCanvas(frontEl, backEl) {
      if (!frontEl && !backEl) throw new Error('Elemen kartu tidak ditemukan');
      if (frontEl && !backEl) return await renderCardToCanvas(frontEl);
      if (!frontEl && backEl) return await renderCardToCanvas(backEl);

      const canvasFront = await renderCardToCanvas(frontEl);
      const canvasBack = await renderCardToCanvas(backEl);

      const gap = 30; // Jarak antar kartu
      const totalWidth = canvasFront.width + canvasBack.width + gap;
      const maxHeight = Math.max(canvasFront.height, canvasBack.height);

      const combinedCanvas = document.createElement('canvas');
      combinedCanvas.width = totalWidth;
      combinedCanvas.height = maxHeight;
      const ctx = combinedCanvas.getContext('2d');

      ctx.fillStyle = '#f8fafc';
      ctx.fillRect(0, 0, totalWidth, maxHeight);

      ctx.drawImage(canvasFront, 0, (maxHeight - canvasFront.height) / 2);
      ctx.drawImage(canvasBack, canvasFront.width + gap, (maxHeight - canvasBack.height) / 2);

      return combinedCanvas;
    }

    // ====================================================
    // UNDUH GAMBAR SATUAN (PNG / JPG)
    // ====================================================
    async function downloadCard(studentId, format = 'png', specificSide = null) {
      const currentSide = specificSide || document.getElementById('selectSide').value;
      const unit = document.getElementById(`card-unit-${studentId}`);
      if (!unit) return;

      const studentName = unit.dataset.studentName || 'Siswa';
      const nis = unit.dataset.nis || studentId;
      const cleanName = studentName.replace(/[^a-zA-Z0-9_-]/g, '_');

      showToast(`Sedang memproses kartu ${studentName} (${format.toUpperCase()})...`, 'info');

      try {
        let canvas;
        if (currentSide === 'back') {
          const el = document.getElementById(`card-back-${studentId}`);
          canvas = await renderCardToCanvas(el);
        } else if (currentSide === 'both') {
          const frontEl = document.getElementById(`card-front-${studentId}`);
          const backEl = document.getElementById(`card-back-${studentId}`);
          canvas = await renderCombinedCardsToCanvas(frontEl, backEl);
        } else {
          const el = document.getElementById(`card-front-${studentId}`);
          canvas = await renderCardToCanvas(el);
        }

        const ext = format === 'jpeg' ? 'jpg' : 'png';
        const mime = format === 'jpeg' ? 'image/jpeg' : 'image/png';
        const dataUrl = canvas.toDataURL(mime, 0.95);

        const link = document.createElement('a');
        link.download = `Kartu_${nis}_${cleanName}_${currentSide}.${ext}`;
        link.href = dataUrl;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);

        showToast(`✅ Kartu ${studentName} berhasil diunduh (${format.toUpperCase()})!`, 'success');
      } catch (err) {
        console.error('Download error:', err);
        showToast(`❌ Gagal mengunduh kartu: ${err.message}`, 'error');
      }
    }

    // ====================================================
    // UNDUH SELURUH KARTU DALAM FILE ZIP
    // ====================================================
    async function downloadAllZip(format = 'png') {
      if (typeof JSZip === 'undefined') {
        alert('Pustaka JSZip belum siap. Silakan muat ulang halaman.');
        return;
      }

      const units = document.querySelectorAll('.card-item-wrapper');
      if (units.length === 0) {
        alert('Tidak ada kartu siswa untuk diunduh.');
        return;
      }

      const zip = new JSZip();
      const folder = zip.folder("Kartu_Pelajar");
      const ext = format === 'jpeg' ? 'jpg' : 'png';
      const mime = format === 'jpeg' ? 'image/jpeg' : 'image/png';
      const side = document.getElementById('selectSide').value;

      showZipModal(`Menyiapkan ${units.length} kartu (${format.toUpperCase()})...`, units.length);

      for (let i = 0; i < units.length; i++) {
        const unit = units[i];
        const studentId = unit.dataset.studentId;
        const name = (unit.dataset.studentName || `Siswa_${studentId}`).replace(/[^a-zA-Z0-9_-]/g, '_');
        const nis = unit.dataset.nis || studentId;

        updateZipModal(i + 1, units.length, `Merender (${i+1}/${units.length}): ${unit.dataset.studentName}`);

        try {
          if (side === 'both') {
            const frontCanvas = await renderCardToCanvas(document.getElementById(`card-front-${studentId}`));
            folder.file(`Kartu_${nis}_${name}_Depan.${ext}`, frontCanvas.toDataURL(mime, 0.95).split(',')[1], { base64: true });

            const backCanvas = await renderCardToCanvas(document.getElementById(`card-back-${studentId}`));
            folder.file(`Kartu_${nis}_${name}_Belakang.${ext}`, backCanvas.toDataURL(mime, 0.95).split(',')[1], { base64: true });
          } else if (side === 'back') {
            const canvas = await renderCardToCanvas(document.getElementById(`card-back-${studentId}`));
            folder.file(`Kartu_${nis}_${name}_Belakang.${ext}`, canvas.toDataURL(mime, 0.95).split(',')[1], { base64: true });
          } else {
            const canvas = await renderCardToCanvas(document.getElementById(`card-front-${studentId}`));
            folder.file(`Kartu_${nis}_${name}_Depan.${ext}`, canvas.toDataURL(mime, 0.95).split(',')[1], { base64: true });
          }
        } catch (err) {
          console.warn('Gagal merender siswa:', studentId, err);
        }
      }

      updateZipModal(units.length, units.length, 'Mengompresi ke file ZIP...');
      const content = await zip.generateAsync({ type: 'blob' });

      const link = document.createElement('a');
      link.download = `Kartu_Pelajar_${new Date().toISOString().slice(0,10)}.zip`;
      link.href = URL.createObjectURL(content);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);

      closeZipModal();
      showToast(`✅ Berhasil mengunduh ${units.length} kartu dalam file ZIP!`, 'success');
    }

    function showZipModal(title, total) {
      document.getElementById('zipProgressTitle').textContent = title;
      document.getElementById('zipProgressCount').textContent = `0 / ${total}`;
      document.getElementById('zipProgressBar').style.width = '0%';
      document.getElementById('zipModalBackdrop').style.display = 'flex';
    }
    function updateZipModal(current, total, sub) {
      const pct = Math.round((current / total) * 100);
      document.getElementById('zipProgressBar').style.width = `${pct}%`;
      document.getElementById('zipProgressCount').textContent = `${current} / ${total} (${pct}%)`;
      if (sub) document.getElementById('zipProgressSub').textContent = sub;
    }
    function closeZipModal() {
      document.getElementById('zipModalBackdrop').style.display = 'none';
    }

    // ====================================================
    // MODAL KIRIM WHATSAPP SATUAN
    // ====================================================
    let currentWaStudentId = null;

    async function openWhatsAppModal(studentId) {
      currentWaStudentId = studentId;
      const unit = document.getElementById(`card-unit-${studentId}`);
      if (!unit) return;

      const studentName = unit.dataset.studentName || 'Siswa';
      const nis = unit.dataset.nis || '';
      const className = unit.dataset.className || '-';
      const parentName = unit.dataset.parentName || '';
      const parentPhone = unit.dataset.parentPhone || '';
      const schoolName = "<%= settings.school_name || 'Sekolah' %>";

      document.getElementById('waModalStudentName').textContent = studentName;
      document.getElementById('waModalMeta').textContent = `NIS: ${nis} • Kelas: ${className}`;
      document.getElementById('waModalPhone').value = parentPhone;

      const isIslamic = (schoolName.toLowerCase().includes('musholla') || schoolName.toLowerCase().includes('tpq') || schoolName.toLowerCase().includes('masjid') || schoolName.toLowerCase().includes('santri') || schoolName.toLowerCase().includes('pesantren'));
      const greeting = isIslamic ? "Assalamu'alaikum Wr. Wb." : "Yth.";
      const titleType = isIslamic ? "Kartu Identitas Santri" : "Kartu Identitas Pelajar";
      const parentGreet = parentName ? `Bapak/Ibu ${parentName}, wali dari ` : `Bapak/Ibu Wali dari `;

      const defaultText = `${greeting}\nKepada ${parentGreet}*${studentName}* (${className})\n\n` +
        `Berikut kami lampirkan *${titleType}* resmi atas nama *${studentName}* (NIS: ${nis}) dari *${schoolName}*.\n\n` +
        `Kartu ini dilengkapi QR Code untuk presensi/kehadiran dan identitas resmi santri/siswa. Silakan simpan kartu ini di galeri handphone Bapak/Ibu.\n\n` +
        `Terima kasih.`;

      document.getElementById('waModalCaption').value = defaultText;

      // Sinkronkan pilihan radio dengan orientasi/sisi saat ini
      const activeSide = document.getElementById('selectSide').value;
      const radioInput = document.querySelector(`input[name="waCardSide"][value="${activeSide}"]`);
      if (radioInput) radioInput.checked = true;

      // Tampilkan modal
      document.getElementById('waModalBackdrop').style.display = 'flex';

      // Muat pratinjau thumbnail
      const previewContainer = document.getElementById('waModalPreview');
      previewContainer.innerHTML = '<span style="font-size:11px;color:#64748b;">Memuat pratinjau kartu...</span>';

      try {
        const frontEl = document.getElementById(`card-front-${studentId}`);
        const canvas = await renderCardToCanvas(frontEl);
        const thumbDataUrl = canvas.toDataURL('image/jpeg', 0.85);
        previewContainer.innerHTML = `<img src="${thumbDataUrl}" style="max-height: 120px; border-radius: 6px; box-shadow: 0 2px 6px rgba(0,0,0,0.15);">`;
      } catch (e) {
        previewContainer.innerHTML = '<span style="font-size:11px;color:#ef4444;">Pratinjau siap saat pengiriman</span>';
      }
    }

    function closeWhatsAppModal() {
      document.getElementById('waModalBackdrop').style.display = 'none';
      currentWaStudentId = null;
    }

    async function sendWhatsAppFromModal() {
      if (!currentWaStudentId) return;
      const phone = document.getElementById('waModalPhone').value.trim();
      const caption = document.getElementById('waModalCaption').value.trim();
      const sideChoice = document.querySelector('input[name="waCardSide"]:checked')?.value || 'front';
      const savePhone = document.getElementById('waModalSavePhone')?.checked || false;

      if (!phone) {
        alert('Silakan masukkan nomor WhatsApp tujuan terlebih dahulu.');
        document.getElementById('waModalPhone').focus();
        return;
      }

      const sendBtn = document.getElementById('waModalSendBtn');
      const origBtnText = sendBtn.innerHTML;
      sendBtn.disabled = true;
      sendBtn.innerHTML = '<span>⏳ Merender & Mengirim...</span>';

      try {
        // 1. Render kartu ke canvas
        let canvas;
        if (sideChoice === 'back') {
          const el = document.getElementById(`card-back-${currentWaStudentId}`);
          canvas = await renderCardToCanvas(el);
        } else if (sideChoice === 'both') {
          const frontEl = document.getElementById(`card-front-${currentWaStudentId}`);
          const backEl = document.getElementById(`card-back-${currentWaStudentId}`);
          canvas = await renderCombinedCardsToCanvas(frontEl, backEl);
        } else {
          const el = document.getElementById(`card-front-${currentWaStudentId}`);
          canvas = await renderCardToCanvas(el);
        }

        // 2. Konversi ke JPEG base64 (resolusi tinggi & hemat kuota)
        const base64Image = canvas.toDataURL('image/jpeg', 0.92);

        // 3. Kirim ke backend endpoint
        const res = await fetch('/dashboard/students/cards/send-wa', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            student_id: currentWaStudentId,
            phone: phone,
            image_base64: base64Image,
            caption: caption,
            save_phone: savePhone,
            side: sideChoice
          })
        });

        const result = await res.json();
        if (!res.ok || !result.success) {
          throw new Error(result.message || 'Gagal mengirim WhatsApp');
        }

        closeWhatsAppModal();
        showToast(`✅ ${result.message}`, 'success');

        // Update nomor di badge kartu
        const unit = document.getElementById(`card-unit-${currentWaStudentId}`);
        if (unit) {
          unit.dataset.parentPhone = phone;
          const phoneBadge = unit.querySelector('.phone-badge');
          if (phoneBadge) {
            phoneBadge.className = 'phone-badge ready';
            phoneBadge.innerHTML = `📱 ${phone}`;
          }
        }
      } catch (err) {
        console.error('Send WA error:', err);
        alert('Gagal mengirim via WhatsApp:\n' + err.message);
      } finally {
        sendBtn.disabled = false;
        sendBtn.innerHTML = origBtnText;
      }
    }

    // ====================================================
    // MODAL & FUNGSI KIRIM WHATSAPP MASSAL
    // ====================================================
    function openBatchWhatsAppModal() {
      const units = document.querySelectorAll('.card-item-wrapper');
      let withPhone = 0;
      let withoutPhone = 0;

      units.forEach(u => {
        if (u.dataset.parentPhone && u.dataset.parentPhone.trim().length > 4) {
          withPhone++;
        } else {
          withoutPhone++;
        }
      });

      document.getElementById('batchWaTotal').textContent = units.length;
      document.getElementById('batchWaReady').textContent = withPhone;
      document.getElementById('batchWaEmpty').textContent = withoutPhone;

      document.getElementById('batchWaFormSection').style.display = 'flex';
      document.getElementById('batchWaProgressSection').style.display = 'none';
      document.getElementById('batchWaCloseBtn').style.display = 'none';

      document.getElementById('batchWaModalBackdrop').style.display = 'flex';
    }

    function closeBatchWhatsAppModal() {
      document.getElementById('batchWaModalBackdrop').style.display = 'none';
    }

    async function startBatchWhatsAppSend() {
      const units = document.querySelectorAll('.card-item-wrapper');
      const targets = Array.from(units).filter(u => u.dataset.parentPhone && u.dataset.parentPhone.trim().length > 4);

      if (targets.length === 0) {
        alert('Tidak ada siswa dengan nomor WhatsApp orang tua yang terdaftar.');
        return;
      }

      document.getElementById('batchWaFormSection').style.display = 'none';
      document.getElementById('batchWaProgressSection').style.display = 'block';

      const sideChoice = document.querySelector('input[name="batchWaSide"]:checked')?.value || 'front';
      const customCaption = document.getElementById('batchWaCaption').value.trim();
      const logContainer = document.getElementById('batchWaLogContainer');
      logContainer.innerHTML = '';

      let successCount = 0;
      let failCount = 0;

      for (let i = 0; i < targets.length; i++) {
        const unit = targets[i];
        const studentId = unit.dataset.studentId;
        const name = unit.dataset.studentName;
        const phone = unit.dataset.parentPhone;

        const percent = Math.round(((i + 1) / targets.length) * 100);
        document.getElementById('batchWaProgressBar').style.width = `${percent}%`;
        document.getElementById('batchWaProgressPercent').textContent = `${percent}%`;
        document.getElementById('batchWaProgressLabel').textContent = `Mengirim (${i+1}/${targets.length}): ${name}`;

        try {
          let canvas;
          if (sideChoice === 'back') {
            canvas = await renderCardToCanvas(document.getElementById(`card-back-${studentId}`));
          } else if (sideChoice === 'both') {
            canvas = await renderCombinedCardsToCanvas(
              document.getElementById(`card-front-${studentId}`),
              document.getElementById(`card-back-${studentId}`)
            );
          } else {
            canvas = await renderCardToCanvas(document.getElementById(`card-front-${studentId}`));
          }

          const base64Image = canvas.toDataURL('image/jpeg', 0.92);

          const res = await fetch('/dashboard/students/cards/send-wa', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              student_id: studentId,
              phone: phone,
              image_base64: base64Image,
              caption: customCaption,
              side: sideChoice
            })
          });

          const data = await res.json();
          if (data.success) {
            successCount++;
            appendBatchLog(`✅ [${i+1}] ${name} (${phone}): Terkirim`, '#16a34a');
          } else {
            failCount++;
            appendBatchLog(`❌ [${i+1}] ${name} (${phone}): ${data.message}`, '#dc2626');
          }
        } catch (err) {
          failCount++;
          appendBatchLog(`❌ [${i+1}] ${name} (${phone}): ${err.message}`, '#dc2626');
        }

        // Jeda 1.5 detik antar pesan agar aman dari rate limit WhatsApp
        if (i < targets.length - 1) {
          await new Promise(r => setTimeout(r, 1500));
        }
      }

      document.getElementById('batchWaProgressLabel').textContent = `Selesai! Berhasil: ${successCount}, Gagal: ${failCount}`;
      document.getElementById('batchWaCloseBtn').style.display = 'inline-flex';
      showToast(`Pengiriman massal selesai: ${successCount} berhasil, ${failCount} gagal`, successCount > 0 ? 'success' : 'error');
    }

    function appendBatchLog(msg, color) {
      const container = document.getElementById('batchWaLogContainer');
      const item = document.createElement('div');
      item.style.color = color;
      item.textContent = msg;
      container.appendChild(item);
      container.scrollTop = container.scrollHeight;
    }

    // ====================================================
    // TOAST NOTIFIKASI
    // ====================================================
    let toastTimeout = null;
    function showToast(message, type = 'info') {
      const toast = document.getElementById('toastNotification');
      if (!toast) return;

      toast.textContent = message;
      if (type === 'success') {
        toast.style.background = '#10b981';
        toast.style.color = '#ffffff';
      } else if (type === 'error') {
        toast.style.background = '#ef4444';
        toast.style.color = '#ffffff';
      } else {
        toast.style.background = '#0f172a';
        toast.style.color = '#ffffff';
      }

      toast.style.display = 'flex';
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.style.display = 'none';
      }, 4000);
    }
  </script>

