          </div>
        </div>
        <div id="batchWaLogContainer" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px; max-height: 160px; overflow-y: auto; font-size: 10.5px; font-family: monospace; display: flex; flex-direction: column; gap: 3px;"></div>
        <div style="margin-top: 12px; display: flex; justify-content: flex-end;">
          <button type="button" id="batchWaCloseBtn" onclick="closeBatchWhatsAppModal()" class="btn btn-secondary" style="display: none;">Tutup</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. Modal Progress ZIP -->
  <div id="zipModalBackdrop" class="no-print" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 16px;">
    <div style="background: #ffffff; width: 100%; max-width: 380px; border-radius: 14px; padding: 20px; text-align: center; box-shadow: 0 20px 40px rgba(0,0,0,0.25);">
      <div style="font-size: 32px; margin-bottom: 8px;">📦</div>
      <h3 style="font-size: 13px; font-weight: 800; color: #0f172a; margin-bottom: 4px;" id="zipProgressTitle">Menyiapkan Berkas ZIP...</h3>
      <p style="font-size: 11px; color: #64748b; margin-bottom: 12px;" id="zipProgressSub">Merender gambar kartu beresolusi tinggi...</p>
      <div style="width: 100%; height: 6px; background: #e2e8f0; border-radius: 9999px; overflow: hidden; margin-bottom: 8px;">
        <div id="zipProgressBar" style="width: 0%; height: 100%; background: #2563eb; transition: width 0.2s ease;"></div>
      </div>
      <span style="font-size: 10.5px; font-weight: 700; color: #94a3b8;" id="zipProgressCount">0 / 0</span>
    </div>
  </div>

  <!-- 4. Floating Toast Notification -->
  <div id="toastNotification" class="no-print" style="position: fixed; bottom: 20px; right: 20px; z-index: 10000; padding: 10px 18px; border-radius: 8px; font-size: 12px; font-weight: 700; box-shadow: 0 4px 16px rgba(0,0,0,0.2); display: none; align-items: center; gap: 8px; transition: all 0.2s ease;"></div>
</body>
</html>
