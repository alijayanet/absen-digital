    // ------------------------------------------
    // H. LIVE DISPLAY ANTRIAN TV (DATA POLLING)
    // ------------------------------------------
    let lastCallSignature = null;
    const callingPrefix = "<%= settings.queue_calling_prefix || 'Nomor antrian' %>";

    async function fetchTablesData() {
      try {
        const res = await fetch('/api/queue/display-data');
        const data = await res.json();
        if (!data.success) return;

        renderTables(data.tables);
        handleCallAudio(data.lastCall);
        if (data.prayer) {
          handlePrayerData(data.prayer);
        }
      } catch (err) {
        console.warn('Fetch queue data error:', err);
      }
    }

    function renderTables(tables) {
      const grid = document.getElementById('tablesGrid');
      if (!tables || tables.length === 0) {
