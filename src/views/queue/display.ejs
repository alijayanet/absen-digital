        <button type="button" onclick="dismissPrayerAlert()" class="px-6 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-bold transition border border-slate-700 shadow inline-flex items-center gap-2">
          <i data-lucide="arrow-left" class="w-4 h-4"></i>
          Kembali ke Antrian Mengaji
