            <div>
              <span class="inline-block text-[9px] font-extrabold px-1.5 py-0.5 rounded ${item.status === 'HADIR' ? 'bg-emerald-950 text-emerald-400 border border-emerald-800' : 'bg-amber-950 text-amber-400 border border-amber-800'}">
