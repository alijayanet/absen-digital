<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-950">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= (typeof title !== 'undefined' && title) ? title : 'Layar Kiosk Presensi & Antrian Mengaji Live' %> - <%= (typeof settings !== 'undefined' && settings && settings.school_name) ? settings.school_name : 'TPQ Al Muhajirin' %></title>
  
  <!-- Tailwind CSS & Google Fonts -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- HTML5 QR Code Scanner CDN -->
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .font-mono { font-family: 'JetBrains Mono', monospace; }

    /* Fix HTML5 QR Code Video Container */
    #qr-reader {
      width: 100% !important;
      height: 100% !important;
      border: none !important;
      background: #090d16 !important;
      position: relative !important;
      overflow: hidden !important;
    }
    #qr-reader__scan_region {
      width: 100% !important;
      height: 100% !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }
    #qr-reader video {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      border-radius: 1rem !important;
    }
    #qr-reader__dashboard_section,
    #qr-reader img[alt="Info icon"] {
      display: none !important;
    }

    /* Laser Scanner Animation */
    @keyframes scanLaser {
      0% { top: 8%; opacity: 0.2; }
      50% { opacity: 1; }
      100% { top: 92%; opacity: 0.2; }
    }
    .animate-scan-laser {
      animation: scanLaser 2s ease-in-out infinite alternate;
    }

    /* Glow Effect for Calling Active Table Card */
    @keyframes pulseGlow {
      0%, 100% {
        box-shadow: 0 0 25px rgba(16, 185, 129, 0.45);
        border-color: rgba(52, 211, 153, 0.9);
      }
      50% {
        box-shadow: 0 0 50px rgba(16, 185, 129, 0.75);
        border-color: rgba(110, 231, 183, 1);
      }
    }
    .calling-card {
      animation: pulseGlow 1.8s infinite;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.6);
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(51, 65, 85, 0.8);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(71, 85, 105, 1);
    }
  </style>
</head>
<body class="h-screen flex flex-col bg-slate-950 text-slate-100 overflow-hidden select-none">

  <!-- ========================================== -->
  <!-- 1. HEADER UTAMA LAYAR MULTIFUNGSI           -->
  <!-- ========================================== -->
  <header class="bg-slate-900/95 border-b border-slate-800 px-3 sm:px-5 py-1.5 sm:py-2 flex items-center justify-between shadow-lg flex-shrink-0 z-30 backdrop-blur-md">
    
    <!-- Info Sekolah & Brand (Leluasa & Luas untuk Nama Sekolah Panjang) -->
    <div class="flex items-center gap-2.5 sm:gap-3 flex-1 min-w-0 pr-4">
      <% if (settings.school_logo) { %>
        <img src="<%= settings.school_logo %>" alt="Logo" class="w-8 h-8 sm:w-10 sm:h-10 object-contain rounded-xl bg-white/10 p-0.5 border border-slate-700/80 shadow flex-shrink-0">
      <% } else { %>
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center text-lg sm:text-xl font-bold shadow flex-shrink-0">
          📖
        </div>
      <% } %>
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-1.5">
          <span class="px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 uppercase tracking-widest flex items-center gap-1 shrink-0">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            Kiosk Presensi RFID & Antrian Live
          </span>
        </div>
        <h1 class="text-xs sm:text-base lg:text-lg xl:text-xl font-black text-white tracking-tight uppercase truncate leading-tight mt-0.5">
          <%= settings.school_name || 'TPQ AL MUHAJIRIN' %>
        </h1>
      </div>
    </div>

    <!-- Tombol Audio, Fullscreen, & Jam Digital -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      
      <!-- Tombol Audio Activator -->
      <button id="audioToggleBtn" onclick="toggleAudio()" class="px-2.5 sm:px-3 py-1 rounded-xl text-[11px] font-bold transition flex items-center gap-1.5 bg-amber-500 hover:bg-amber-400 text-slate-950 shadow cursor-pointer">
        <i data-lucide="volume-2" class="w-3.5 h-3.5"></i>
        <span id="audioBtnText" class="hidden sm:inline">Aktifkan Suara Bel</span>
      </button>

      <!-- Tombol Layar Penuh -->
      <button onclick="toggleFullscreen()" class="p-1.5 sm:p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 transition cursor-pointer border border-slate-700 shadow-sm" title="Layar Penuh (F11)">
        <i data-lucide="maximize" class="w-3.5 h-3.5 sm:w-4 sm:h-4"></i>
      </button>

      <!-- Jam Digital Sesuai Zona Waktu Wilayah -->
      <div class="text-right pl-2 border-l border-slate-800">
        <div id="liveClock" class="text-base sm:text-xl lg:text-2xl font-black text-emerald-400 font-mono tracking-wider leading-tight">
          <% if (typeof initialData !== 'undefined' && initialData && initialData.prayer && initialData.prayer.localTime) { %>
            <%= String(initialData.prayer.localTime.hour).padStart(2, '0') %>:<%= String(initialData.prayer.localTime.minute).padStart(2, '0') %>:<%= String(initialData.prayer.localTime.second).padStart(2, '0') %>
          <% } else { %>
            --:--:--
          <% } %>
        </div>
        <div id="liveDate" class="text-[9px] sm:text-[10px] text-slate-400 font-semibold truncate hidden sm:block leading-tight">
          <% if (typeof initialData !== 'undefined' && initialData && initialData.prayer && initialData.prayer.schedule) { %>
            <%= initialData.prayer.schedule.date %> (<%= initialData.prayer.schedule.timezoneName %>)
          <% } else { %>
            Memuat...
          <% } %>
        </div>
      </div>
    </div>
  </header>

  <!-- ========================================== -->
  <!-- 2. BANNER PENGUMUMAN PANGGILAN TERBARU     -->
  <!-- ========================================== -->
  <div id="callBanner" class="bg-gradient-to-r from-emerald-950 via-emerald-800 to-teal-900 border-b border-emerald-500/50 px-4 py-1.5 flex items-center justify-between text-xs transition-all duration-300 opacity-0 -translate-y-2 pointer-events-none z-20 shrink-0">
    <div class="flex items-center gap-2.5 min-w-0">
      <span class="p-0.5 rounded-lg bg-emerald-500 text-slate-950 font-black text-[10px] px-2 animate-bounce flex items-center gap-1 shadow shrink-0">
        <i data-lucide="bell" class="w-3 h-3 fill-current"></i>
        <span>MEMANGGIL</span>
      </span>
      <span id="callBannerText" class="text-emerald-100 font-black text-xs sm:text-sm truncate">
        Menunggu panggilan berikutnya...
      </span>
    </div>
    <div class="text-[10px] text-emerald-300 font-semibold hidden md:flex items-center gap-1 shrink-0">
      <i data-lucide="arrow-right-circle" class="w-3.5 h-3.5"></i>
      Santri dimohon segera menuju meja penguji
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 3. MAIN CONTAINER: SATU FRAME DUA FUNGSI   -->
  <!-- ========================================== -->
  <main id="mainContainer" class="flex-1 p-2 sm:p-3 overflow-hidden grid grid-cols-1 lg:grid-cols-12 gap-2.5 items-stretch min-h-0">
    
    <!-- ---------------------------------------- -->
    <!-- FRAME KIRI: KIOSK SCANNER PRESENSI MANDIRI -->
    <!-- ---------------------------------------- -->
    <section id="kioskPane" class="lg:col-span-4 xl:col-span-4 flex flex-col gap-2 min-w-0 h-full min-h-0 transition-all duration-300">
      
      <!-- Card Kiosk Scanner (Fokus Penuh RFID Mandiri) -->
      <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-3 shadow-xl flex flex-col justify-between shrink-0 relative overflow-hidden backdrop-blur-sm">
        
        <!-- Header Panel RFID -->
        <div class="flex items-center justify-between pb-1.5 border-b border-slate-800/80 mb-2">
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <h2 class="text-[11px] font-black text-white uppercase tracking-wider flex items-center gap-1.5">
              <i data-lucide="credit-card" class="w-3.5 h-3.5 text-emerald-400"></i>
              Presensi Siswa RFID
            </h2>
          </div>
          <span class="px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
            Reader Siaga
          </span>
        </div>

        <!-- Zona Animasi Tap RFID (Pengganti Kamera) -->
        <div class="relative w-full py-5 px-3 bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 rounded-xl overflow-hidden flex flex-col items-center justify-center border border-dashed border-emerald-500/40 shadow-inner group">
          <div class="relative w-14 h-14 rounded-2xl bg-gradient-to-tr from-emerald-600/30 to-teal-500/20 border border-emerald-500/50 flex items-center justify-center text-emerald-400 shadow-[0_0_20px_rgba(16,185,129,0.25)] mb-2 group-hover:scale-105 transition-transform">
            <span class="absolute w-full h-full rounded-2xl bg-emerald-400/20 animate-ping"></span>
            <i data-lucide="radio" class="w-7 h-7 text-emerald-400"></i>
          </div>
          <p class="text-xs font-black text-white tracking-wide uppercase">Tempelkan Kartu Santri</p>
          <p class="text-[10px] text-slate-400 mt-0.5">Dekatkan kartu RFID / gantungan ke reader</p>
        </div>

        <!-- Slot Tampilan Status RFID USB (Readonly agar tidak memicu keyboard virtual TV) -->
        <div class="mt-2 space-y-1">
          <div class="bg-slate-950/90 border border-slate-800 rounded-lg p-1.5 flex items-center gap-2 shadow-inner">
            <i data-lucide="scan-line" class="w-3.5 h-3.5 text-emerald-400 animate-pulse shrink-0"></i>
            <input 
              type="text" 
              id="rfidInput" 
              readonly
              tabindex="-1"
              placeholder="Siaga membaca tap RFID..." 
              autocomplete="off"
              class="bg-transparent border-none text-[11px] text-emerald-400 font-mono focus:outline-none w-full placeholder-slate-500 pointer-events-none select-none"
            >
          </div>

          <div class="flex items-center justify-between text-[9px] text-slate-400 px-1 font-medium">
            <span class="flex items-center gap-1 text-emerald-400">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span> USB Reader Standby
            </span>
            <span class="text-slate-500">
              *Tap langsung terdata
            </span>
          </div>
        </div>
      </div>

      <!-- Feed Presensi Terkini Sesi Ini -->
      <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-2.5 shadow-xl flex-1 flex flex-col min-h-0 overflow-hidden">
        <div class="flex items-center justify-between mb-1 pb-1 border-b border-slate-800/80 shrink-0">
          <h3 class="text-[10px] font-bold text-slate-300 uppercase tracking-wider flex items-center gap-1">
            <i data-lucide="history" class="w-3 h-3 text-blue-400"></i>
            Presensi Terkini & Antrian
          </h3>
          <span class="text-[9px] font-mono text-slate-500">Hari Ini</span>
        </div>

        <div id="recentScansList" class="space-y-1.5 overflow-y-auto flex-1 min-h-0 pr-0.5">
          <div class="text-center py-4 text-slate-500 text-xs italic">
            Belum ada santri yang tap presensi sesi ini.
          </div>
        </div>
      </div>

    </section>

    <!-- ---------------------------------------- -->
    <!-- FRAME KANAN: DISPLAY ANTRIAN MENGAJI LIVE  -->
    <!-- ---------------------------------------- -->
    <section id="queuePane" class="lg:col-span-8 xl:col-span-8 flex flex-col gap-2 min-w-0 h-full min-h-0 transition-all duration-300">
      
      <!-- Baris Indikator Meja -->
      <div class="bg-slate-900/90 border border-slate-800 rounded-xl px-3 py-1 flex items-center justify-between shadow shrink-0 text-xs backdrop-blur-sm">
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-[11px] font-black text-white uppercase tracking-wider">
            Status Meja Panggilan Mengaji Santri
          </span>
        </div>
        <div class="flex items-center gap-2 text-[10px]">
          <span class="text-slate-400">
            Suara TV: <strong class="text-emerald-400">Aktif</strong>
          </span>
          <span class="hidden sm:inline text-slate-600">&bull;</span>
          <span class="text-slate-400 hidden sm:inline">
            Meja: <strong class="text-white">Multi-Kelas TPQ</strong>
          </span>
        </div>
      </div>

      <!-- Grid Meja Penguji (Auto-Render Realtime) -->
      <div id="tablesGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 shrink-0 items-start">
        <!-- Rendered by JavaScript -->
        <div class="col-span-full py-6 text-center text-slate-500">
          <div class="animate-spin w-5 h-5 border-2 border-emerald-500 border-t-transparent rounded-full mx-auto mb-2"></div>
          <p class="text-xs font-semibold">Memuat daftar meja antrian santri...</p>
        </div>
      </div>

      <!-- Jadwal Sholat Lengkap & Ticker Hadits (Mengisi Area Bawah Pas 1 Frame) -->
      <div id="prayerScheduleCard" class="bg-slate-900/80 border border-slate-800 rounded-2xl p-2.5 shadow-xl flex-1 flex flex-col justify-between min-h-0 overflow-hidden backdrop-blur-sm">
        <!-- Header Bar Jadwal Sholat -->
        <div class="flex items-center justify-between pb-1.5 border-b border-slate-800/80 shrink-0">
          <div class="flex items-center gap-2">
            <span class="text-base leading-none">🕌</span>
            <div>
              <h3 class="text-xs font-black text-white uppercase tracking-wider flex items-center gap-1.5">
                Jadwal Waktu Sholat
                <span class="text-slate-500 font-normal">|</span>
                <span id="prayerCityDisplay" class="text-[10px] font-bold text-emerald-400 capitalize">
                  <%= (settings && settings.prayer_city_name) ? settings.prayer_city_name : 'Kab. Indramayu / Cirebon' %>
                </span>
                <span id="prayerTzDisplay" class="px-1.5 py-0.5 rounded bg-slate-800 text-[9px] font-mono text-emerald-400 font-bold border border-slate-700">
                  <%= (typeof initialData !== 'undefined' && initialData && initialData.prayer && initialData.prayer.schedule) ? initialData.prayer.schedule.timezoneName : 'WIB' %>
                </span>
              </h3>
            </div>
          </div>
          <div id="nextPrayerBadge" class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-lg bg-emerald-950/80 border border-emerald-500/40 text-[10px] font-bold text-emerald-300 shadow-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
            <span>Menuju <strong id="nextPrayerName" class="text-white"><%= (typeof initialData !== 'undefined' && initialData && initialData.prayer && initialData.prayer.nextInfo && initialData.prayer.nextInfo.next) ? initialData.prayer.nextInfo.next.label : 'Subuh' %></strong>:</span>
            <span id="nextPrayerCountdown" class="font-mono text-emerald-400 font-black"><%= (typeof initialData !== 'undefined' && initialData && initialData.prayer && initialData.prayer.nextInfo) ? initialData.prayer.nextInfo.formattedCountdown : '--:--:--' %></span>
          </div>
        </div>

        <!-- 7 Kolom Waktu Sholat (Kompak & Ramping: Tinggi Terpangkas Rapi!) -->
        <div class="grid grid-cols-7 gap-1.5 my-1 text-center font-mono shrink-0">
          <div id="card_imsak" class="prayer-time-box py-0.5 sm:py-1 px-1 rounded-xl bg-slate-950/70 border border-slate-800 flex flex-col justify-center transition-all duration-300 shadow-inner">
            <span class="text-[8px] sm:text-[9px] font-bold text-slate-400 uppercase font-sans tracking-wide">Imsak</span>
            <strong id="time_imsak" class="text-xs sm:text-sm font-black text-slate-300 mt-0.5"><%= (typeof initialData !== 'undefined' && initialData && initialData.prayer && initialData.prayer.schedule) ? initialData.prayer.schedule.imsak : '--:--' %></strong>
          </div>
          <div id="card_subuh" class="prayer-time-box py-0.5 sm:py-1 px-1 rounded-xl bg-slate-950/70 border border-slate-800 flex flex-col justify-center transition-all duration-300 shadow-inner <%= (typeof initialData !== 'undefined' && initialData && initialData.prayer && initialData.prayer.nextInfo && initialData.prayer.nextInfo.next && initialData.prayer.nextInfo.next.key === 'subuh') ? 'border-emerald-500 bg-emerald-950/60 ring-2 ring-emerald-400/50' : '' %>">
            <span class="text-[8px] sm:text-[9px] font-bold text-emerald-400 uppercase font-sans tracking-wide">Subuh</span>
            <strong id="time_subuh" class="text-xs sm:text-sm font-black text-white mt-0.5"><%= (typeof initialData !== 'undefined' && initialData && initialData.prayer && initialData.prayer.schedule) ? initialData.prayer.schedule.subuh : '--:--' %></strong>
          </div>
          <div id="card_terbit" class="prayer-time-box py-0.5 sm:py-1 px-1 rounded-xl bg-slate-950/70 border border-slate-800 flex flex-col justify-center transition-all duration-300 shadow-inner <%= (typeof initialData !== 'undefined' && initialData && initialData.prayer && initialData.prayer.nextInfo && initialData.prayer.nextInfo.next && initialData.prayer.nextInfo.next.key === 'terbit') ? 'border-emerald-500 bg-emerald-950/60 ring-2 ring-emerald-400/50' : '' %>">
            <span class="text-[8px] sm:text-[9px] font-bold text-amber-400/80 uppercase font-sans tracking-wide">Syuruq</span>
            <strong id="time_terbit" class="text-xs sm:text-sm font-black text-slate-300 mt-0.5"><%= (typeof initialData !== 'undefined' && initialData && initialData.prayer && initialData.prayer.schedule) ? initialData.prayer.schedule.terbit : '--:--' %></strong>
          </div>
          <div id="card_dzuhur" class="prayer-time-box py-0.5 sm:py-1 px-1 rounded-xl bg-slate-950/70 border border-slate-800 flex flex-col justify-center transition-all duration-300 shadow-inner <%= (typeof initialData !== 'undefined' && initialData && initialData.prayer && initialData.prayer.nextInfo && initialData.prayer.nextInfo.next && initialData.prayer.nextInfo.next.key === 'dzuhur') ? 'border-emerald-500 bg-emerald-950/60 ring-2 ring-emerald-400/50' : '' %>">
            <span class="text-[8px] sm:text-[9px] font-bold text-cyan-400 uppercase font-sans tracking-wide">Dzuhur</span>
            <strong id="time_dzuhur" class="text-xs sm:text-sm font-black text-white mt-0.5"><%= (typeof initialData !== 'undefined' && initialData && initialData.prayer && initialData.prayer.schedule) ? initialData.prayer.schedule.dzuhur : '--:--' %></strong>
          </div>
          <div id="card_ashar" class="prayer-time-box py-0.5 sm:py-1 px-1 rounded-xl bg-slate-950/70 border border-slate-800 flex flex-col justify-center transition-all duration-300 shadow-inner <%= (typeof initialData !== 'undefined' && initialData && initialData.prayer && initialData.prayer.nextInfo && initialData.prayer.nextInfo.next && initialData.prayer.nextInfo.next.key === 'ashar') ? 'border-emerald-500 bg-emerald-950/60 ring-2 ring-emerald-400/50' : '' %>">
            <span class="text-[8px] sm:text-[9px] font-bold text-teal-400 uppercase font-sans tracking-wide">Ashar</span>
            <strong id="time_ashar" class="text-xs sm:text-sm font-black text-white mt-0.5"><%= (typeof initialData !== 'undefined' && initialData && initialData.prayer && initialData.prayer.schedule) ? initialData.prayer.schedule.ashar : '--:--' %></strong>
          </div>
          <div id="card_maghrib" class="prayer-time-box py-0.5 sm:py-1 px-1 rounded-xl bg-slate-950/70 border border-slate-800 flex flex-col justify-center transition-all duration-300 shadow-inner <%= (typeof initialData !== 'undefined' && initialData && initialData.prayer && initialData.prayer.nextInfo && initialData.prayer.nextInfo.next && initialData.prayer.nextInfo.next.key === 'maghrib') ? 'border-emerald-500 bg-emerald-950/60 ring-2 ring-emerald-400/50' : '' %>">
            <span class="text-[8px] sm:text-[9px] font-bold text-rose-400 uppercase font-sans tracking-wide">Maghrib</span>
            <strong id="time_maghrib" class="text-xs sm:text-sm font-black text-white mt-0.5"><%= (typeof initialData !== 'undefined' && initialData && initialData.prayer && initialData.prayer.schedule) ? initialData.prayer.schedule.maghrib : '--:--' %></strong>
          </div>
          <div id="card_isya" class="prayer-time-box py-0.5 sm:py-1 px-1 rounded-xl bg-slate-950/70 border border-slate-800 flex flex-col justify-center transition-all duration-300 shadow-inner <%= (typeof initialData !== 'undefined' && initialData && initialData.prayer && initialData.prayer.nextInfo && initialData.prayer.nextInfo.next && initialData.prayer.nextInfo.next.key === 'isya') ? 'border-emerald-500 bg-emerald-950/60 ring-2 ring-emerald-400/50' : '' %>">
            <span class="text-[8px] sm:text-[9px] font-bold text-indigo-400 uppercase font-sans tracking-wide">Isya</span>
            <strong id="time_isya" class="text-xs sm:text-sm font-black text-white mt-0.5"><%= (typeof initialData !== 'undefined' && initialData && initialData.prayer && initialData.prayer.schedule) ? initialData.prayer.schedule.isya : '--:--' %></strong>
          </div>
        </div>

        <!-- Mutiara Hadits & Motivasi Santri Mengaji (Area Luas, Font Lebih Besar & Jelas) -->
        <div id="haditsContainer" class="flex-1 min-h-0 flex flex-col justify-center rounded-xl p-3 sm:p-4 bg-gradient-to-r from-emerald-950/40 via-slate-950/70 to-emerald-950/40 border border-emerald-500/30 shadow-inner overflow-hidden transition-all duration-500">
          <div class="flex items-center justify-between pb-1 border-b border-slate-800/60 shrink-0">
            <div class="flex items-center gap-1.5">
              <span class="text-sm text-emerald-400">📖</span>
              <span class="text-[10px] sm:text-xs font-black uppercase tracking-widest text-emerald-300">
                Mutiara Hadits & Keutamaan Al-Qur'an
              </span>
            </div>
            <span id="islamicQuoteSource" class="px-2.5 py-0.5 rounded-md bg-emerald-950/90 border border-emerald-500/40 text-[9px] sm:text-[11px] font-mono font-bold text-emerald-300">
              HR. Bukhari no. 5027
            </span>
          </div>

          <div class="my-auto py-2 text-center flex flex-col justify-center">
            <!-- Teks Kaligrafi Arab Lebih Besar & Elegan -->
