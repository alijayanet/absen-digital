                  <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                  <span class="text-xs font-bold text-slate-300">Belum Ada Panggilan</span>
                </div>
                <span class="text-[10px] text-slate-500 font-mono">Ustadz siap memanggil</span>
              </div>
