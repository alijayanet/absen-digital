  <!-- ========================================== -->
  <!-- 6. JAVASCRIPT: LOGIKA DUAL-SCREEN TERPADU   -->
  <!-- ========================================== -->
  <script>
    lucide.createIcons();

    // ------------------------------------------
    // INISIALISASI DATA JADWAL SHOLAT & STATE GLOBAL
    // ------------------------------------------
    window.currentPrayerData = <%- JSON.stringify((typeof initialData !== 'undefined' && initialData && initialData.prayer) ? initialData.prayer : null) %>;
    var currentPrayerData = window.currentPrayerData;
    var localCountdownSeconds = (currentPrayerData && currentPrayerData.nextInfo) ? currentPrayerData.nextInfo.remainingSeconds : 0;
    var iqomahCountdownTimer = null;
    var alertedPrayersToday = new Set();
    var isPrayerAlertActive = false;

    // ------------------------------------------
    // A. MODE VIEW SWITCHER (DUAL / QUEUE / KIOSK)
    // ------------------------------------------
    let currentMode = 'dual';

    function setViewMode(mode) {
      currentMode = mode;
      const kioskPane = document.getElementById('kioskPane');
      const queuePane = document.getElementById('queuePane');
      const btnDual = document.getElementById('modeBtnDual');
      const btnQueue = document.getElementById('modeBtnQueue');
      const btnKiosk = document.getElementById('modeBtnKiosk');

      // Reset classes tombol
      const inactiveClass = 'px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 text-slate-400 hover:text-white cursor-pointer';
      const activeClass = 'px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 bg-emerald-600 text-white shadow cursor-pointer';

      if (btnDual) btnDual.className = inactiveClass;
      if (btnQueue) btnQueue.className = inactiveClass;
      if (btnKiosk) btnKiosk.className = inactiveClass;

      if (mode === 'dual') {
        kioskPane.classList.remove('hidden');
        queuePane.classList.remove('hidden');
        kioskPane.className = 'lg:col-span-4 xl:col-span-4 flex flex-col gap-3 min-w-0 transition-all duration-300';
        queuePane.className = 'lg:col-span-8 xl:col-span-8 flex flex-col gap-3 min-w-0 transition-all duration-300';
        if (btnDual) btnDual.className = activeClass;
      } else if (mode === 'queue_only') {
        kioskPane.classList.add('hidden');
        queuePane.classList.remove('hidden');
        queuePane.className = 'col-span-12 flex flex-col gap-3 min-w-0 transition-all duration-300';
        if (btnQueue) btnQueue.className = activeClass;
      } else if (mode === 'kiosk_only') {
        queuePane.classList.add('hidden');
        kioskPane.classList.remove('hidden');
        kioskPane.className = 'col-span-12 max-w-2xl mx-auto w-full flex flex-col gap-3 min-w-0 transition-all duration-300';
        if (btnKiosk) btnKiosk.className = activeClass;
      }
    }

    // ------------------------------------------
    // B. JAM DIGITAL REALTIME SESUAI ZONA WILAYAH
    // ------------------------------------------
    function updateClock() {
      try {
        const tzMap = { 7: 'Asia/Jakarta', 8: 'Asia/Makassar', 9: 'Asia/Jayapura' };
        const tzKey = (typeof currentPrayerData !== 'undefined' && currentPrayerData && currentPrayerData.schedule) ? currentPrayerData.schedule.timezone : 7;
        const timeZone = tzMap[tzKey] || 'Asia/Jakarta';
        const tzLabel = (typeof currentPrayerData !== 'undefined' && currentPrayerData && currentPrayerData.schedule) ? (currentPrayerData.schedule.timezoneName || 'WIB') : 'WIB';

        const now = new Date();
        const timeParts = new Intl.DateTimeFormat('id-ID', {
          timeZone,
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false
        }).format(now);

        const clockEl = document.getElementById('liveClock');
        if (clockEl) clockEl.innerText = timeParts;

        const dateParts = new Intl.DateTimeFormat('id-ID', {
          timeZone,
          weekday: 'long',
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        }).format(now);

        const dateEl = document.getElementById('liveDate');
        if (dateEl) dateEl.innerText = `${dateParts} (${tzLabel})`;
      } catch (e) {
        try {
          const now = new Date();
          const h = String(now.getHours()).padStart(2, '0');
          const m = String(now.getMinutes()).padStart(2, '0');
          const s = String(now.getSeconds()).padStart(2, '0');
          const clockEl = document.getElementById('liveClock');
          if (clockEl) clockEl.innerText = `${h}:${m}:${s}`;
          const dateEl = document.getElementById('liveDate');
          if (dateEl) dateEl.innerText = now.toLocaleDateString('id-ID');
        } catch (_) {}
      }
    }
    setInterval(updateClock, 1000);
    updateClock();

    // ------------------------------------------
    // C. FULLSCREEN HANDLER (F11)
    // ------------------------------------------
    function toggleFullscreen() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        if (document.exitFullscreen) document.exitFullscreen();
      }
    }

    // ------------------------------------------
    // D. AUDIO ENGINE: SYNTHESIZER & TTS OFFLINE
    // ------------------------------------------
    let audioUnlocked = false;
    let audioCtx = null;

    function initAudio() {
      if (!audioCtx) {
        const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioCtxClass();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }

      // Buka izin autoplay HTML5 Audio untuk pemutaran TTS
      try {
        const dummy = new Audio('data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEARKwAAIhYAQACABAAZGF0YQAAAAA=');
        dummy.play().then(() => dummy.pause()).catch(() => {});
      } catch (_) {}

      audioUnlocked = true;
      const btn = document.getElementById('audioToggleBtn');
      const txt = document.getElementById('audioBtnText');
      if (btn && txt) {
        btn.className = 'px-3 sm:px-4 py-1.5 sm:py-2 rounded-xl text-xs font-bold transition flex items-center gap-2 bg-emerald-600 text-white shadow-lg cursor-pointer';
        txt.innerText = '✓ Audio Bel & Suara Aktif';
      }
    }

    function toggleAudio() {
      initAudio();
      playChime();
    }

    // Bel Ding-Dong Sintetis Web Audio API (D5 -> A5)
    function playChime() {
      try {
        if (!audioUnlocked) initAudio();
        const now = audioCtx.currentTime;

        // Nada Pertama (D5 ~587.33 Hz)
        const osc1 = audioCtx.createOscillator();
        const gain1 = audioCtx.createGain();
        osc1.type = 'sine';
        osc1.frequency.setValueAtTime(587.33, now);
        gain1.gain.setValueAtTime(0.5, now);
        gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.6);
        osc1.connect(gain1);
        gain1.connect(audioCtx.destination);
        osc1.start(now);
        osc1.stop(now + 0.6);

        // Nada Kedua (A5 ~880.00 Hz)
        const osc2 = audioCtx.createOscillator();
        const gain2 = audioCtx.createGain();
        osc2.type = 'sine';
        osc2.frequency.setValueAtTime(880.00, now + 0.4);
        gain2.gain.setValueAtTime(0.5, now + 0.4);
        gain2.gain.exponentialRampToValueAtTime(0.001, now + 1.2);
        osc2.connect(gain2);
        gain2.connect(audioCtx.destination);
        osc2.start(now + 0.4);
        osc2.stop(now + 1.2);
      } catch (err) {
        console.warn('Audio chime error:', err);
      }
    }

    // Efek Beep Presensi Kiosk
    function playKioskBeep(type) {
      try {
        if (!audioCtx) {
          const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
          audioCtx = new AudioCtxClass();
        }
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);

        if (type === 'SUCCESS') {
          osc.type = 'sine';
          osc.frequency.setValueAtTime(523.25, now); // C5
          osc.frequency.setValueAtTime(783.99, now + 0.1); // G5
          gain.gain.setValueAtTime(0.3, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
          osc.start(now);
          osc.stop(now + 0.35);
        } else if (type === 'WARNING') {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(440, now);
          gain.gain.setValueAtTime(0.3, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
          osc.start(now);
          osc.stop(now + 0.3);
        } else {
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(180, now);
          gain.gain.setValueAtTime(0.35, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
          osc.start(now);
          osc.stop(now + 0.35);
        }
      } catch (e) {}
    }

    // ------------------------------------------
    // D2. TEXT-TO-SPEECH (TTS) LOGAT INDONESIA ALAMI
    // ------------------------------------------
    let currentCallAudio = null;

    // Helper format nama santri agar diucapkan utuh mengalir (tidak dieja per huruf)
    function formatStudentNameForSpeech(raw) {
      if (!raw) return '';
      let name = String(raw).trim();
      name = name.replace(/\(.*?\)/g, ' ').replace(/\[.*?\]/g, ' ');
      name = name.toLowerCase().replace(/(?:^|\s|\/|-)\S/g, (c) => c.toUpperCase());
      name = name
        .replace(/\bM\.\s*/gi, 'Muhammad ')
        .replace(/\bMuh\.\s*/gi, 'Muhammad ')
        .replace(/\bMoh\.\s*/gi, 'Muhammad ')
        .replace(/\bAch?\.\s*/gi, 'Ahmad ')
        .replace(/\bAbd\.\s*/gi, 'Abdul ')
        .replace(/\bIbnu\.\s*/gi, 'Ibnu ')
        .replace(/\bH\.\s*/gi, 'Haji ')
        .replace(/\bHj\.\s*/gi, 'Hajjah ')
        .replace(/\bSiti\.\s*/gi, 'Siti ');
      name = name.replace(/['`’]/g, '');
      name = name.replace(/[^a-zA-Z0-9\s]/g, ' ');
      return name.replace(/\s+/g, ' ').trim();
    }

    // Helper terbilang nomor antrian Bahasa Indonesia
    function numberToIndoWords(num) {
      const satuan = ['', 'satu', 'dua', 'tiga', 'empat', 'lima', 'enam', 'tujuh', 'delapan', 'sembilan', 'sepuluh', 'sebelas'];
      const n = parseInt(num, 10);
      if (isNaN(n) || n <= 0) return String(num);
      if (n < 10) return `nol ${satuan[n]}`;
      if (n < 12) return satuan[n];
      if (n < 20) return `${satuan[n - 10]} belas`;
      if (n < 100) {
        const puluhan = Math.floor(n / 10);
        const sisa = n % 10;
        return `${satuan[puluhan]} puluh${sisa !== 0 ? ' ' + satuan[sisa] : ''}`;
      }
      return String(n);
    }

    // Pemutar Panggilan Suara Manusia Logat Indonesia Alami
    function speakCall(text) {
      if (!text) return;

      setTimeout(() => {
        try {
          if (currentCallAudio) {
            currentCallAudio.pause();
            currentCallAudio.currentTime = 0;
            currentCallAudio.src = '';
            currentCallAudio = null;
          }

          // Prioritas 1: Engine Suara Manusia Alami Logat Indonesia via Server TTS
          const audioUrl = `/api/tts?text=${encodeURIComponent(text)}&_t=${Date.now()}`;
          const audio = new Audio();
          audio.src = audioUrl;
          currentCallAudio = audio;

          audio.onended = () => {
            currentCallAudio = null;
          };

          audio.onerror = (e) => {
            console.warn('Audio TTS element error, beralih ke fallback browser:', e);
            speakCallFallback(text);
          };

          const playPromise = audio.play();
          if (playPromise !== undefined) {
            playPromise.catch((err) => {
              console.warn('Pemutaran audio TTS server gagal/terblokir, beralih ke fallback browser:', err);
              speakCallFallback(text);
            });
          }
        } catch (err) {
          console.warn('Audio TTS exception, beralih ke fallback:', err);
          speakCallFallback(text);
        }
      }, 1100);
    }

    // Fallback cadangan Web Speech API jika jaringan/server audio offline
    function speakCallFallback(text) {
      try {
        if (!('speechSynthesis' in window)) return;
        window.speechSynthesis.cancel();
        const utter = new SpeechSynthesisUtterance(text);
        utter.lang = 'id-ID';
        utter.rate = 0.92;
        utter.pitch = 1.0;

        const voices = window.speechSynthesis.getVoices();
        const idVoice = voices.find(v => (v.lang && (v.lang.toLowerCase().startsWith('id') || v.lang.toLowerCase().includes('indonesia'))));
        if (idVoice) utter.voice = idVoice;

        window.speechSynthesis.speak(utter);
      } catch (err) {
        console.warn('Speech synthesis fallback error:', err);
      }
    }

    // ------------------------------------------
    // E. RFID INPUT LISTENER GLOBAL (KIOSK & ANDROID TV)
    // ------------------------------------------
    const rfidInput = document.getElementById('rfidInput');
    // Murni mendengarkan RFID di background tanpa pernah memanggil focus() agar keyboard virtual TV tidak muncul
    let isProcessingScan = false;
    let globalRfidBuffer = '';
    let lastKeypressTime = 0;
    const RFID_TIMEOUT_MS = 500;

    // 2. Listener Global Window (Membaca USB RFID Reader meskipun kursor tidak di kotak input)
    window.addEventListener('keydown', (e) => {
      // Abaikan jika fokus sedang berada di input lain (seperti modal/search)
      if (e.target && e.target.tagName === 'INPUT' && e.target.id !== 'rfidInput') return;
      if (e.target && (e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT')) return;

      const now = Date.now();
      if (now - lastKeypressTime > RFID_TIMEOUT_MS) {
        globalRfidBuffer = '';
      }
      lastKeypressTime = now;

      if (e.key === 'Enter') {
        const scannedCode = globalRfidBuffer.trim();
        globalRfidBuffer = '';
        if (scannedCode.length >= 3 && !isProcessingScan) {
          e.preventDefault();
          if (rfidInput) rfidInput.value = '';
          processAttendance(scannedCode);
        }
      } else if (e.key.length === 1) {
        // Karakter alphanumeric UID kartu
        if (/[a-zA-Z0-9]/.test(e.key)) {
          globalRfidBuffer += e.key;
        }
      }
    });

    // ------------------------------------------
    // F. HTML5 QR CODE SCANNER (KAMERA KIOSK)
    // ------------------------------------------
    let html5QrCode = null;
    let cameraRunning = false;
    let currentFacingMode = 'environment';

    const toggleCameraBtn = document.getElementById('toggleCameraBtn');
    const switchCameraBtn = document.getElementById('switchCameraBtn');
    const cameraPlaceholder = document.getElementById('cameraPlaceholder');
    const scanLaserLine = document.getElementById('scanLaserLine');
    const cameraStatusDot = document.getElementById('cameraStatusDot');

    async function startCamera() {
      try {
        if (cameraRunning && html5QrCode) {
          await stopCamera();
          return;
        }

        html5QrCode = new Html5Qrcode("qr-reader");
        cameraPlaceholder.classList.add('hidden');
        scanLaserLine.classList.remove('hidden');
        if (cameraStatusDot) cameraStatusDot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse';

        const config = {
          fps: 15,
          qrbox: { width: 180, height: 180 },
          aspectRatio: 1.0
        };

        await html5QrCode.start(
          { facingMode: currentFacingMode },
          config,
          (decodedText) => {
            if (!isProcessingScan) {
              processAttendance(decodedText);
            }
          },
          () => {}
        );

        cameraRunning = true;
        if (switchCameraBtn) switchCameraBtn.classList.remove('hidden');
      } catch (err) {
        console.warn('Camera start error:', err);
        cameraPlaceholder.classList.remove('hidden');
        scanLaserLine.classList.add('hidden');
        if (cameraStatusDot) cameraStatusDot.className = 'w-2.5 h-2.5 rounded-full bg-rose-500';
        cameraRunning = false;
      }
    }

    async function stopCamera() {
      if (html5QrCode && cameraRunning) {
        try {
          await html5QrCode.stop();
          html5QrCode.clear();
        } catch (e) {}
      }
      cameraRunning = false;
      cameraPlaceholder.classList.remove('hidden');
      scanLaserLine.classList.add('hidden');
      if (switchCameraBtn) switchCameraBtn.classList.add('hidden');
      if (cameraStatusDot) cameraStatusDot.className = 'w-2.5 h-2.5 rounded-full bg-slate-500';
    }

    if (toggleCameraBtn) {
      toggleCameraBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        initAudio();
        if (cameraRunning) stopCamera();
        else startCamera();
      });
    }

    const viewfinderWrapper = document.getElementById('viewfinderWrapper');
    if (viewfinderWrapper) {
      viewfinderWrapper.addEventListener('click', () => {
        initAudio();
        if (!cameraRunning) startCamera();
      });
    }

    if (switchCameraBtn) {
      switchCameraBtn.addEventListener('click', async (e) => {
        e.stopPropagation();
        currentFacingMode = currentFacingMode === 'environment' ? 'user' : 'environment';
        await stopCamera();
        startCamera();
      });
    }

    // ------------------------------------------
    // G. PROSES PRESENSI & MODAL HASIL (KIOSK)
    // ------------------------------------------
    const resultModal = document.getElementById('resultModal');
    const resultCard = document.getElementById('resultCard');
    const resPhoto = document.getElementById('resPhoto');
    const resAvatarFallback = document.getElementById('resAvatarFallback');
    const resBadge = document.getElementById('resBadge');
    const resName = document.getElementById('resName');
    const resMeta = document.getElementById('resMeta');
    const resMessage = document.getElementById('resMessage');
    const recentScansList = document.getElementById('recentScansList');
    const recentScans = [];

    async function processAttendance(code) {
      isProcessingScan = true;
      initAudio();

      try {
        const response = await fetch('/api/attendance/scan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code })
        });

        const data = await response.json();
        showResultModal(data);

        if (data.student) {
          addRecentScan(data.student, data.status, data.timeIn, data.queue);
        }

        // SINKRONISASI INSTAN KE SISI KANAN DISPLAY ANTRIAN
        fetchTablesData();

      } catch (err) {
        showResultModal({
          success: false,
          code: 'NETWORK_ERROR',
          message: 'Koneksi ke server gagal. Periksa jaringan.'
        });
      } finally {
        setTimeout(() => {
          isProcessingScan = false;
          if (rfidInput) rfidInput.value = '';
        }, 1500);
      }
    }

    let modalTimer = null;

    function showResultModal(data) {
      clearTimeout(modalTimer);

      if (data.student) {
        resName.innerText = data.student.name;
        resMeta.innerText = `Kelas ${data.student.class_name || '-'} • NIS: ${data.student.nis}`;
        if (data.student.photo) {
          resPhoto.src = data.student.photo;
          resPhoto.classList.remove('hidden');
          resAvatarFallback.classList.add('hidden');
        } else {
          resAvatarFallback.innerText = data.student.name.charAt(0);
          resAvatarFallback.classList.remove('hidden');
          resPhoto.classList.add('hidden');
        }
      } else {
        resName.innerText = 'Tidak Dikenal';
        resMeta.innerText = 'Kartu / QR Code tidak terdaftar';
        resAvatarFallback.innerText = 'X';
        resAvatarFallback.classList.remove('hidden');
        resPhoto.classList.add('hidden');
      }

      resMessage.innerText = data.message;

      // Tampilkan Nomor Antrian Mengaji
      const resQueueBox = document.getElementById('resQueueBox');
      const resQueueNumber = document.getElementById('resQueueNumber');
      const resQueueClass = document.getElementById('resQueueClass');
      if (resQueueBox) {
        if (data.queue && data.queue.queue_number) {
          resQueueNumber.innerText = `#${String(data.queue.queue_number).padStart(2, '0')}`;
          resQueueClass.innerText = data.queue.class_name || (data.student ? data.student.class_name : 'Meja');
          resQueueBox.classList.remove('hidden');
        } else {
          resQueueBox.classList.add('hidden');
        }
      }

      // Konfigurasi Badge Warna & Audio
      if (data.code === 'SUCCESS') {
        if (data.status === 'HADIR') {
          resBadge.className = 'inline-flex items-center gap-2 px-4 py-1 rounded-full text-xs font-black uppercase tracking-wider mb-2 bg-emerald-500/20 text-emerald-400 border border-emerald-500/40';
          resBadge.innerText = '✓ HADIR TEPAT WAKTU';
          playKioskBeep('SUCCESS');
        } else {
          resBadge.className = 'inline-flex items-center gap-2 px-4 py-1 rounded-full text-xs font-black uppercase tracking-wider mb-2 bg-amber-500/20 text-amber-400 border border-amber-500/40';
          resBadge.innerText = `⚠ TERLAMBAT (${data.lateMinutes} MENIT)`;
          playKioskBeep('WARNING');
        }
      } else if (data.code === 'ALREADY_ATTENDED') {
        resBadge.className = 'inline-flex items-center gap-2 px-4 py-1 rounded-full text-xs font-black uppercase tracking-wider mb-2 bg-blue-500/20 text-blue-400 border border-blue-500/40';
        resBadge.innerText = 'ℹ SUDAH ABSEN HARI INI';
        playKioskBeep('WARNING');
      } else {
        resBadge.className = 'inline-flex items-center gap-2 px-4 py-1 rounded-full text-xs font-black uppercase tracking-wider mb-2 bg-rose-500/20 text-rose-400 border border-rose-500/40';
        resBadge.innerText = '✕ TIDAK TERDAFTAR';
