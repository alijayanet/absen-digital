            <!-- 2. Kartu Santri yang Sedang Di Meja / Dipanggil -->
            ${cur ? `
              <div class="p-2 sm:p-2.5 rounded-xl ${isCalling ? 'bg-gradient-to-br from-emerald-950 via-teal-900 to-slate-900 border border-emerald-500/70 shadow-[0_0_15px_rgba(16,185,129,0.3)]' : 'bg-slate-950/90 border border-slate-800'} shadow">
                <div class="flex items-center justify-between mb-0.5">
                  <span class="text-[9px] font-black uppercase tracking-wider ${isCalling ? 'text-emerald-300 animate-pulse' : 'text-slate-400'}">
                    ${isCalling ? '📢 SEDANG DIPANGGIL' : '🟢 SEDANG MENGAJI'}
                  </span>
                  <span class="text-[9px] font-mono text-slate-400">Panggilan Ke-${cur.call_count || 1}</span>
                </div>

                <div class="flex items-center gap-2.5 my-0.5">
                  <div class="text-3xl sm:text-4xl font-black text-emerald-400 font-mono tracking-tight shrink-0 drop-shadow">
                    #${String(cur.queue_number).padStart(2, '0')}
