            <!-- 3. CARD ANTRIAN BERIKUTNYA (Naik ke Atas!) -->
            <div class="p-2 rounded-xl bg-slate-950/70 border border-slate-800/80">
              <div class="flex items-center justify-between mb-1">
                <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Antrian Berikutnya:</span>
                <span class="text-[9px] font-mono font-bold text-emerald-400">${table.nextWaiting ? table.nextWaiting.length : 0} Menunggu</span>
              </div>
              <div class="flex items-center gap-1.5 flex-wrap overflow-hidden max-h-[30px]">
                ${table.nextWaiting && table.nextWaiting.length > 0 ? table.nextWaiting.slice(0, 6).map(w => `
                  <span class="px-2 py-0.5 rounded-lg bg-slate-800 text-slate-200 border border-slate-700 font-mono text-[11px] font-bold shadow-sm" title="${w.student_name}">
                    #${String(w.queue_number).padStart(2, '0')}
