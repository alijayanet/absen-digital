                `).join('') : '<span class="text-[10px] text-slate-500 italic py-0.5">Tidak ada antrian menunggu</span>'}
              </div>
            </div>

            <!-- 4. CARD-CARD SUMMARY NYA (Naik ke Atas & Kompak!) -->
            <div class="grid grid-cols-3 gap-1.5 text-center text-[10px]">
              <div class="bg-slate-950/80 px-2 py-1 rounded-xl border border-slate-800/80 flex items-center justify-between shadow-inner">
                <span class="text-slate-400 font-medium">Menunggu</span>
                <strong class="text-amber-400 font-mono text-xs font-black">${table.stats.waiting}</strong>
              </div>
              <div class="bg-slate-950/80 px-2 py-1 rounded-xl border border-slate-800/80 flex items-center justify-between shadow-inner">
                <span class="text-slate-400 font-medium">Mengaji</span>
                <strong class="text-emerald-400 font-mono text-xs font-black">${table.stats.serving}</strong>
              </div>
              <div class="bg-slate-950/80 px-2 py-1 rounded-xl border border-slate-800/80 flex items-center justify-between shadow-inner">
                <span class="text-slate-400 font-medium">Selesai</span>
                <strong class="text-teal-400 font-mono text-xs font-black">${table.stats.completed}</strong>
              </div>
            </div>

          </div>
        `;
      }).join('');
      lucide.createIcons();
    }

    function handleCallAudio(lastCall) {
      if (!lastCall) return;

      const qId = lastCall.queueId || lastCall.id || lastCall.queue_number;
      const cAt = lastCall.calledAt || lastCall.called_at || '';
      const cCount = lastCall.callCount || lastCall.call_count || 1;
      const signature = `${qId}_${cAt}_${cCount}`;

      if (signature !== lastCallSignature) {
        lastCallSignature = signature;

        // Tampilkan Banner Panggilan
        const banner = document.getElementById('callBanner');
        const textEl = document.getElementById('callBannerText');
        const qNum = lastCall.queueNumber || lastCall.queue_number || 1;
        const sName = lastCall.studentName || lastCall.student_name || 'Santri';
        const cName = lastCall.className || lastCall.class_name || 'Meja';
        const targetTeacher = lastCall.teacherName || lastCall.teacher_name || lastCall.className || 'Ustadz';

        if (textEl) {
          textEl.innerText = `${callingPrefix} #${formattedNum} - ${sName} ➔ Silakan menuju ${targetTeacher}`;
        }
        if (banner) {
          banner.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
        }

        // Mainkan Ding-Dong Chime & Panggilan Suara TTS
        playChime();

        // Ucapkan nomor dan nama santri secara utuh dan alami menuju Ustadz/Guru
        let speechSentence = lastCall.speechSentence;
        if (!speechSentence) {
          const numWords = numberToIndoWords(qNum);
          const cleanName = formatStudentNameForSpeech(sName);
          speechSentence = `${callingPrefix} ${numWords}, ${cleanName}, silakan menuju ${targetTeacher}.`;
        }
        speakCall(speechSentence);

        // Tutup banner setelah 8 detik
        clearTimeout(window.bannerTimer);
        window.bannerTimer = setTimeout(() => {
          if (banner) banner.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');
        }, 8000);
      }
    }

    // ------------------------------------------
    // I. JADWAL SHOLAT & PERINGATAN WAKTU TIBA
    // ------------------------------------------

    const islamicQuotes = [
      {
        arabic: "خَيْرُكُمْ مَنْ تَعَلَّمَ الْقُرْآنَ وَعَلَّمَهُ",
        indonesian: '"Sebaik-baik kalian adalah orang yang belajar Al-Qur\'an dan mengajarkannya."',
        source: "HR. Bukhari no. 5027"
      },
      {
        arabic: "مَنْ قَرَأَ حَرْفًا مِنْ كِتَابِ اللَّهِ فَلَهُ بِهِ حَسَنَةٌ",
        indonesian: '"Barangsiapa membaca satu huruf dari Kitabullah (Al-Qur\'an), maka baginya satu kebaikan dengan sepuluh kelipatan."',
        source: "HR. Tirmidzi no. 2910"
      },
      {
        arabic: "أَحَبُّ الأَعْمَالِ إِلَى اللَّهِ الصَّلاَةُ عَلَى وَقْتِهَا",
        indonesian: '"Amalan yang paling dicintai oleh Allah adalah mendirikan sholat tepat pada awal waktunya."',
        source: "HR. Bukhari & Muslim"
      },
      {
        arabic: "الْمَاهِرُ بِالْقُرْآنِ مَعَ السَّفَرَةِ الْكِرَامِ الْبَرَرَةِ",
        indonesian: '"Orang yang mahir membaca Al-Qur\'an akan bersama para malaikat yang mulia lagi taat."',
        source: "HR. Muslim no. 798"
      },
      {
        arabic: "مَنْ سَلَكَ طَرِيقًا يَلْتَمِسُ فِيهِ عِلْمًا سَهَّلَ اللَّهُ لَهُ بِهِ طَرِيقًا إِلَى الْجَنَّةِ",
        indonesian: '"Barangsiapa menempuh jalan untuk menuntut ilmu, Allah mudahkan baginya jalan menuju surga."',
        source: "HR. Muslim no. 2699"
      },
      {
        arabic: "اقْرَءُوا الْقُرْآنَ فَإِنَّهُ يَأْتِي يَوْمَ الْقِيَامَةِ شَفِيعًا لِأَصْحَابِهِ",
        indonesian: '"Bacalah Al-Qur\'an, karena sesungguhnya ia akan datang pada hari kiamat sebagai pemberi syafaat bagi para pembacanya."',
        source: "HR. Muslim no. 804"
      }
    ];
    let quoteIndex = 0;

    function rotateIslamicQuote() {
      const elArabic = document.getElementById('islamicQuoteArabic');
      const elIndo = document.getElementById('islamicQuoteIndo');
      const elSource = document.getElementById('islamicQuoteSource');
      if (!elArabic || !elIndo) return;

      quoteIndex = (quoteIndex + 1) % islamicQuotes.length;
      const q = islamicQuotes[quoteIndex];

      elArabic.style.opacity = '0';
      elIndo.style.opacity = '0';
      setTimeout(() => {
        elArabic.textContent = q.arabic;
        elIndo.textContent = q.indonesian;
        if (elSource) elSource.textContent = q.source;
        elArabic.style.opacity = '1';
        elIndo.style.opacity = '1';
      }, 350);
    }
    setInterval(rotateIslamicQuote, 12000);

    function playPrayerChime() {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        if (ctx.state === 'suspended') ctx.resume();

        // 4 Nada lonceng Islami harmonis bertahap: C5, E5, G5, C6
        const freqs = [523.25, 659.25, 783.99, 1046.50];
        freqs.forEach((freq, i) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.value = freq;
          const startTime = ctx.currentTime + (i * 0.45);
          gain.gain.setValueAtTime(0, startTime);
          gain.gain.linearRampToValueAtTime(0.35, startTime + 0.05);
          gain.gain.exponentialRampToValueAtTime(0.0001, startTime + 2.0);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(startTime);
          osc.stop(startTime + 2.1);
        });
      } catch (err) {
        console.warn('Prayer chime sound error:', err);
      }
    }

    function handlePrayerData(prayer) {
      if (!prayer || !prayer.schedule) return;
      currentPrayerData = prayer;

      // Sembunyikan atau tampilkan card sesuai konfigurasi
      const prayerCard = document.getElementById('prayerScheduleCard');
      if (prayer.settings && prayer.settings.prayer_enabled === '0') {
        if (prayerCard) prayerCard.classList.add('hidden');
        return;
      } else {
        if (prayerCard) prayerCard.classList.remove('hidden');
      }

      // Update Teks Jam Sholat
      const s = prayer.schedule;
      const elImsak = document.getElementById('time_imsak');
      const elSubuh = document.getElementById('time_subuh');
      const elTerbit = document.getElementById('time_terbit');
      const elDzuhur = document.getElementById('time_dzuhur');
      const elAshar = document.getElementById('time_ashar');
      const elMaghrib = document.getElementById('time_maghrib');
      const elIsya = document.getElementById('time_isya');

      if (elImsak) elImsak.textContent = s.imsak;
      if (elSubuh) elSubuh.textContent = s.subuh;
      if (elTerbit) elTerbit.textContent = s.terbit;
      if (elDzuhur) elDzuhur.textContent = s.dzuhur;
      if (elAshar) elAshar.textContent = s.ashar;
      if (elMaghrib) elMaghrib.textContent = s.maghrib;
      if (elIsya) elIsya.textContent = s.isya;

      if (prayer.settings && prayer.settings.prayer_city_name) {
        const cityEl = document.getElementById('prayerCityDisplay');
        if (cityEl) cityEl.textContent = prayer.settings.prayer_city_name;
      }

      if (prayer.schedule && prayer.schedule.timezoneName) {
        const tzEl = document.getElementById('prayerTzDisplay');
        if (tzEl) tzEl.textContent = prayer.schedule.timezoneName;
      }

      // Highlight Sholat Berikutnya
      if (prayer.nextInfo && prayer.nextInfo.next) {
        const nextKey = prayer.nextInfo.next.key;
        document.querySelectorAll('.prayer-time-box').forEach(box => {
          box.classList.remove('border-emerald-500', 'bg-emerald-950/60', 'ring-2', 'ring-emerald-400/50');
        });
        const targetBox = document.getElementById(`card_${nextKey}`);
        if (targetBox) {
          targetBox.classList.add('border-emerald-500', 'bg-emerald-950/60', 'ring-2', 'ring-emerald-400/50');
        }

        const nextNameEl = document.getElementById('nextPrayerName');
        if (nextNameEl) nextNameEl.textContent = prayer.nextInfo.next.label;

        // Set remaining seconds jika selisih > 3 detik
        if (Math.abs(localCountdownSeconds - prayer.nextInfo.remainingSeconds) > 3) {
          localCountdownSeconds = prayer.nextInfo.remainingSeconds;
        }
      }
      updateClock();
    }

    // Detik mundur live lokal untuk Countdown Waktu Sholat Berikutnya & Pengecekan Waktu Sholat Tiba
    setInterval(() => {
      if (localCountdownSeconds > 0) {
        localCountdownSeconds--;
        const h = Math.floor(localCountdownSeconds / 3600);
        const m = Math.floor((localCountdownSeconds % 3600) / 60);
        const s = localCountdownSeconds % 60;
        const countdownStr = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        const cdEl = document.getElementById('nextPrayerCountdown');
        if (cdEl) cdEl.textContent = countdownStr;
      }

      // Cek apakah waktu sholat fardhu tiba detik ini
      checkPrayerAlertTime();
    }, 1000);

    function checkPrayerAlertTime() {
      if (!currentPrayerData || isPrayerAlertActive) return;
      const settings = currentPrayerData.settings || {};
      if (settings.prayer_alert_enabled !== '1') return;

      const tzKey = currentPrayerData.schedule ? currentPrayerData.schedule.timezone : 7;
      const tzMap = { 7: 'Asia/Jakarta', 8: 'Asia/Makassar', 9: 'Asia/Jayapura' };
      const timeZone = tzMap[tzKey] || 'Asia/Jakarta';

      const now = new Date();
      let currentTimeStr = '';
      let currentSeconds = now.getSeconds();

      try {
        const parts = new Intl.DateTimeFormat('en-US', {
          timeZone,
          hour: '2-digit',
          minute: '2-digit',
          second: 'numeric',
          hour12: false
        }).formatToParts(now);

        const getP = (t) => parts.find(p => p.type === t).value;
        const h = getP('hour') === '24' ? '00' : getP('hour');
        const m = getP('minute');
        currentTimeStr = `${h}:${m}`;
        currentSeconds = parseInt(getP('second')) || 0;
      } catch (e) {
        currentTimeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
      }

      const fardhuKeys = ['subuh', 'dzuhur', 'ashar', 'maghrib', 'isya'];
      const schedule = currentPrayerData.schedule || {};

      for (const key of fardhuKeys) {
        if (schedule[key] === currentTimeStr && currentSeconds <= 5) {
          const alertKey = `${currentPrayerData.schedule.date}_${key}`;
          if (!alertedPrayersToday.has(alertKey)) {
            alertedPrayersToday.add(alertKey);
            const prayerName = key.charAt(0).toUpperCase() + key.slice(1);
            const iqomahMinutes = parseInt(settings.prayer_iqomah_duration) || 10;
            triggerPrayerAlert(prayerName, iqomahMinutes);
            break;
          }
        }
      }
    }

    function triggerPrayerAlert(prayerName, iqomahDurationMinutes) {
      isPrayerAlertActive = true;
      const overlay = document.getElementById('prayerAlertOverlay');
      const titleEl = document.getElementById('alertPrayerTitle');
      const timerEl = document.getElementById('alertIqomahTimer');
      if (!overlay) return;

      titleEl.textContent = `WAKTU SHOLAT ${prayerName.toUpperCase()} TELAH TIBA`;
      overlay.classList.remove('opacity-0', 'pointer-events-none');

      // Mainkan Nada Lonceng Pengingat Sholat
      playPrayerChime();

      // Mulai Countdown Menuju Iqomah
      let remainingIqomahSeconds = iqomahDurationMinutes * 60;
      clearInterval(iqomahCountdownTimer);

      const updateTimerDisplay = () => {
        const m = Math.floor(remainingIqomahSeconds / 60);
        const s = remainingIqomahSeconds % 60;
        timerEl.textContent = `${String(m).padStart(2, '0')} : ${String(s).padStart(2, '0')}`;
      };
      updateTimerDisplay();

      iqomahCountdownTimer = setInterval(() => {
        remainingIqomahSeconds--;
        if (remainingIqomahSeconds <= 0) {
          clearInterval(iqomahCountdownTimer);
          dismissPrayerAlert();
        } else {
          updateTimerDisplay();
        }
      }, 1000);
    }

    function dismissPrayerAlert() {
      clearInterval(iqomahCountdownTimer);
      const overlay = document.getElementById('prayerAlertOverlay');
      if (overlay) {
        overlay.classList.add('opacity-0', 'pointer-events-none');
      }
      isPrayerAlertActive = false;
    }

    // Polling Interval setiap 2.5 Detik
    setInterval(fetchTablesData, 2500);

    // Initial Load & Auto Start Camera on Desktop
    window.addEventListener('DOMContentLoaded', () => {
      fetchTablesData();
      setTimeout(() => {
        startCamera();
      }, 500);
    });
  </script>
</body>
</html>
