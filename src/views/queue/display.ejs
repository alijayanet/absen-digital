            <div class="w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-400 font-black flex items-center justify-center shrink-0">
              ${item.student.name.charAt(0)}
            </div>
            <div class="min-w-0">
              <p class="font-bold text-white leading-tight truncate">${item.student.name}</p>
              <p class="text-[10px] text-slate-400 truncate">${item.student.class_name || '-'}</p>
